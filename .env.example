# Server Configuration
PORT=3000
NODE_ENV=development

# Migration / Schema Management DB Connection (Administrative user)
MIGRATION_DB_HOST=localhost
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=betting_db
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=postgres_admin_secret

# Application Runtime DB Connection (Least-privilege app user: no DDL, no DELETE/UPDATE on ledger)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=betting_db
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_secret
