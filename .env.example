# EXCLUSIVAMENTE LOCAL: exemplo para execução nativa; não contém credenciais reais.
# O roteiro Docker do README cria .env.local próprio e não depende deste arquivo.
# Server Configuration
PORT=3000
NODE_ENV=development

# Migration / Schema Management DB Connection (Administrative user)
MIGRATION_DB_HOST=localhost
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=betting_db
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=postgres_admin_secret

# Application Runtime DB Connection (Least-privilege app user: no DDL, no DELETE/UPDATE on ledger)
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=betting_db
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_secret

# Workers & Distributed Processing (M10, M14, M15, M16)
SQS_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
PENDING_WORKER_ENABLED=true
WAGER_TRANSACTIONS_QUEUE_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/wager-transactions.fifo
WAGER_TRANSACTIONS_DLQ_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/wager-transactions-dlq.fifo
OUTBOX_EVENTS_QUEUE_URL=http://127.0.0.1:4566/queue/us-east-1/000000000000/wager-events.fifo
SQS_REQUEST_TIMEOUT_MS=5000

# M16: transport retries are independent of financial reference attempts.
SQS_CONSUMER_VISIBILITY_SECONDS=30
SQS_CONSUMER_RENEWAL_MS=10000
SQS_CONSUMER_RETRY_BASE_SECONDS=2
SQS_CONSUMER_RETRY_MAX_SECONDS=300
SQS_CONSUMER_DRAIN_TIMEOUT_MS=10000
