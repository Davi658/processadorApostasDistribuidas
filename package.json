{
  "name": "processador-apostas-distribuidas",
  "version": "1.0.0",
  "description": "Backend financeiro distribu\u00eddo de processamento de apostas com precis\u00e3o monet\u00e1ria e idempot\u00eancia",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun run scripts/run-tests.ts",
    "test:unit": "bun run scripts/run-tests.ts tests/unit",
    "test:integration": "bun run scripts/run-tests.ts tests/integration",
    "test:concurrency": "bun run scripts/run-tests.ts tests/concurrency",
    "typecheck": "tsc --noEmit",
    "test:m15": "bun run scripts/run-tests.ts tests/integration/sqs-inbox-m15.test.ts",
    "test:m14": "bun run scripts/run-tests.ts tests/integration/outbox-publisher-m14.test.ts",
    "test:m17": "bun run scripts/run-tests.ts tests/integration/m17-read-endpoints.test.ts",
    "test:m16": "bun run scripts/run-tests.ts tests/integration/sqs-consumer-m16.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@mikro-orm/cli": "^6.4.9",
    "@mikro-orm/core": "^6.4.9",
    "@mikro-orm/migrations": "^6.4.9",
    "@mikro-orm/postgresql": "^6.4.9",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.2.4",
    "typescript": "^5.8.2"
  }
}
